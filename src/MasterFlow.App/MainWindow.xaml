<Window x:Class="MasterFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="МастерFlow"
        Width="1100"
        Height="720"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontSize="16"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        AutomationProperties.Name="МастерFlow — помощник частного мастера"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,4,8,4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionDescription" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="MaxWidth" Value="760" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="24,16"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="30" FontWeight="Bold" Text="МастерFlow" />
                <TextBlock Margin="0,4,0,0" Text="Клиенты, записи и обратная связь — в одной программе." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="16,10"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       Text="Программа готова к работе."
                       TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                       AutomationProperties.HelpText="Состояние программы"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="0,0,1,0">
                <GroupBox Header="Разделы программы">
                    <TreeView x:Name="NavigationTree"
                              Margin="8"
                              BorderThickness="0"
                              AutomationProperties.Name="Дерево разделов программы"
                              AutomationProperties.HelpText="Выберите раздел стрелками и нажмите Enter."
                              SelectedItemChanged="NavigationTree_SelectedItemChanged">
                        <TreeViewItem x:Name="TodayNavigationItem" Header="Сегодня" Tag="Today" />
                        <TreeViewItem Header="Клиенты" Tag="Clients" />
                        <TreeViewItem Header="Расписание" Tag="Schedule" />
                        <TreeViewItem Header="Обратная связь" IsExpanded="True">
                            <TreeViewItem Header="Отзывы Avito" Tag="Reviews" />
                            <TreeViewItem Header="Анализ переписки" Tag="Conversations" />
                        </TreeViewItem>
                        <TreeViewItem Header="Настройки" Tag="Settings" />
                    </TreeView>
                </GroupBox>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Padding="28"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="TodayPanel">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Сегодня" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Здесь показаны ближайшие записи и действия, которые нельзя забыть." />
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="Создать запись"
                                    AutomationProperties.Name="Создать запись"
                                    AutomationProperties.HelpText="Открывает форму новой записи на сеанс."
                                    Click="OpenSchedule_Click" />
                            <Button Content="Обновить список"
                                    AutomationProperties.Name="Обновить список ближайших записей"
                                    Click="Refresh_Click" />
                        </WrapPanel>
                        <Label Target="{Binding ElementName=UpcomingAppointmentsList}" Content="Ближайшие записи" FontWeight="SemiBold" />
                        <ListBox x:Name="UpcomingAppointmentsList"
                                 MinHeight="180"
                                 DisplayMemberPath="AccessibleSummary"
                                 AutomationProperties.Name="Список ближайших записей"
                                 AutomationProperties.HelpText="Каждый пункт содержит имя клиента, услугу, время сеанса и время напоминания.">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyAppointmentsText"
                                   Margin="0,12,0,0"
                                   Text="Записей пока нет. Нажмите «Создать запись», чтобы добавить первую."
                                   TextWrapping="Wrap" />

                        <Separator Margin="0,24,0,20" />
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Напоминания клиентам" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="Программа подготовит текст. Отправьте его удобным способом, затем отметьте напоминание как отправленное."
                                   TextWrapping="Wrap" />
                        <Label Target="{Binding ElementName=ClientRemindersList}"
                               Content="Список напоминаний"
                               FontWeight="SemiBold" />
                        <ListBox x:Name="ClientRemindersList"
                                 MinHeight="160"
                                 MaxHeight="300"
                                 DisplayMemberPath="AccessibleSummary"
                                 AutomationProperties.Name="Список напоминаний клиентам"
                                 AutomationProperties.HelpText="Сначала показаны напоминания, которые пора отправить. Каждый пункт содержит статус, клиента, контакт, услугу и время сеанса."
                                 SelectionChanged="ClientRemindersList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyRemindersText"
                                   Margin="0,8,0,4"
                                   Text="Напоминаний пока нет. Они появятся после создания записи."
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="CopyReminderButton"
                                    Content="Скопировать текст напоминания"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Скопировать текст выбранного напоминания"
                                    AutomationProperties.HelpText="Копирует готовый текст, который можно вставить в чат с клиентом."
                                    Click="CopyReminder_Click" />
                            <Button x:Name="MarkReminderSentButton"
                                    Content="Отметить как отправленное"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Отметить выбранное напоминание как отправленное"
                                    Click="MarkReminderSent_Click" />
                            <Button x:Name="ResetReminderButton"
                                    Content="Вернуть в ожидающие"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Вернуть выбранное напоминание в ожидающие"
                                    AutomationProperties.HelpText="Используйте, если отметили отправку по ошибке."
                                    Click="ResetReminder_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="ClientsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Клиенты" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Клиенты и записи сохраняются на этом компьютере. Выберите клиента, чтобы открыть карточку и историю посещений." />

                        <Label Target="{Binding ElementName=ClientSearchTextBox}" Content="Поиск клиента" />
                        <TextBox x:Name="ClientSearchTextBox"
                                 AutomationProperties.Name="Поиск клиента"
                                 AutomationProperties.HelpText="Введите имя, контакт или слово из заметки."
                                 TextChanged="ClientSearchTextBox_TextChanged" />
                        <Label Target="{Binding ElementName=ClientsList}" Content="Список клиентов" FontWeight="SemiBold" />
                        <ListBox x:Name="ClientsList"
                                 MinHeight="220"
                                 MaxHeight="320"
                                 DisplayMemberPath="Name"
                                 AutomationProperties.Name="Список клиентов"
                                 SelectionChanged="ClientsList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock x:Name="EmptyClientsText"
                                   Margin="0,12,0,0"
                                   Text="Клиентов пока нет. Клиент появится здесь после создания первой записи."
                                   TextWrapping="Wrap" />

                        <GroupBox x:Name="ClientCardGroupBox"
                                  Header="Карточка клиента"
                                  Margin="0,20,0,0"
                                  Padding="12"
                                  Visibility="Collapsed">
                            <StackPanel>
                                <Label Target="{Binding ElementName=ClientCardNameTextBox}" Content="Имя клиента" />
                                <TextBox x:Name="ClientCardNameTextBox"
                                         AutomationProperties.Name="Имя клиента в карточке" />

                                <Label Target="{Binding ElementName=ClientCardContactTextBox}" Content="Контакт" />
                                <TextBox x:Name="ClientCardContactTextBox"
                                         AutomationProperties.Name="Контакт клиента в карточке" />

                                <Label Target="{Binding ElementName=ClientCardSourceTextBox}" Content="Источник клиента" />
                                <TextBox x:Name="ClientCardSourceTextBox"
                                         AutomationProperties.Name="Источник клиента"
                                         AutomationProperties.HelpText="Например, Avito или рекомендация." />

                                <Label Target="{Binding ElementName=ClientCardNotesTextBox}" Content="Заметка" />
                                <TextBox x:Name="ClientCardNotesTextBox"
                                         MinHeight="80"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="Заметка о клиенте в карточке" />

                                <WrapPanel Margin="0,0,0,16">
                                    <Button Content="Сохранить изменения"
                                            AutomationProperties.Name="Сохранить изменения карточки клиента"
                                            Click="SaveClientChanges_Click" />
                                    <Button Content="Создать следующую запись"
                                            AutomationProperties.Name="Создать следующую запись для выбранного клиента"
                                            Click="CreateAppointmentForSelectedClient_Click" />
                                    <Button Content="Удалить клиента"
                                            AutomationProperties.Name="Удалить выбранного клиента и его записи"
                                            AutomationProperties.HelpText="Перед удалением программа попросит подтверждение."
                                            Click="DeleteSelectedClient_Click" />
                                </WrapPanel>

                                <Label Target="{Binding ElementName=ClientHistoryList}"
                                       Content="История и будущие записи"
                                       FontWeight="SemiBold" />
                                <ListBox x:Name="ClientHistoryList"
                                         MinHeight="120"
                                         MaxHeight="280"
                                         DisplayMemberPath="AccessibleSummary"
                                         AutomationProperties.Name="История и будущие записи выбранного клиента">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock x:Name="EmptyClientHistoryText"
                                           Margin="0,8,0,0"
                                           Text="У клиента пока нет записей."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <StackPanel x:Name="SchedulePanel" Visibility="Collapsed" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Новая запись" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Заполните данные клиента и выберите время сеанса. Все поля, кроме заметки, обязательны." />

                        <Label Target="{Binding ElementName=ClientNameTextBox}" Content="Имя клиента" />
                        <TextBox x:Name="ClientNameTextBox"
                                 AutomationProperties.Name="Имя клиента"
                                 AutomationProperties.HelpText="Например, Анна." />

                        <Label Target="{Binding ElementName=ClientContactTextBox}" Content="Контакт клиента" />
                        <TextBox x:Name="ClientContactTextBox"
                                 AutomationProperties.Name="Контакт клиента"
                                 AutomationProperties.HelpText="Например, телефон, имя пользователя или номер чата Avito." />

                        <Label Target="{Binding ElementName=ServiceNameTextBox}" Content="Услуга" />
                        <TextBox x:Name="ServiceNameTextBox"
                                 AutomationProperties.Name="Услуга"
                                 AutomationProperties.HelpText="Например, массаж спины." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Target="{Binding ElementName=AppointmentDatePicker}" Content="Дата сеанса" />
                                <DatePicker x:Name="AppointmentDatePicker"
                                            AutomationProperties.Name="Дата сеанса" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Target="{Binding ElementName=AppointmentTimeTextBox}" Content="Время сеанса" />
                                <TextBox x:Name="AppointmentTimeTextBox"
                                         AutomationProperties.Name="Время сеанса"
                                         AutomationProperties.HelpText="Введите время в формате часы, двоеточие, минуты. Например, 15:30." />
                            </StackPanel>
                        </Grid>

                        <Label Target="{Binding ElementName=ReminderComboBox}" Content="Когда напомнить" />
                        <ComboBox x:Name="ReminderComboBox"
                                  SelectedIndex="2"
                                  AutomationProperties.Name="Когда напомнить клиенту">
                            <ComboBoxItem Content="За 30 минут" Tag="30" />
                            <ComboBoxItem Content="За 1 час" Tag="60" />
                            <ComboBoxItem Content="За 2 часа" Tag="120" />
                            <ComboBoxItem Content="За 1 день" Tag="1440" />
                        </ComboBox>

                        <Label Target="{Binding ElementName=ClientNotesTextBox}" Content="Заметка, необязательно" />
                        <TextBox x:Name="ClientNotesTextBox"
                                 MinHeight="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 AutomationProperties.Name="Заметка о клиенте" />

                        <WrapPanel>
                            <Button Content="Сохранить запись"
                                    IsDefault="True"
                                    AutomationProperties.Name="Сохранить запись"
                                    Click="SaveAppointment_Click" />
                            <Button Content="Очистить форму"
                                    AutomationProperties.Name="Очистить форму новой записи"
                                    Click="ClearForm_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel x:Name="ReviewsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Отзывы Avito" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Откройте Avito в защищённой браузерной сессии программы. Если потребуется вход или проверка, выполните её самостоятельно. Когда вы откроете окно отзывов, импорт начнётся автоматически." />

                        <Label Target="{Binding ElementName=AvitoUrlTextBox}" Content="Ссылка на объявление или профиль Avito" />
                        <TextBox x:Name="AvitoUrlTextBox"
                                 AutomationProperties.Name="Ссылка на объявление или профиль Avito"
                                 AutomationProperties.HelpText="Вставьте полную ссылку, которая начинается с https:// и ведёт на avito.ru." />

                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Открыть Avito"
                                    AutomationProperties.Name="Открыть ссылку Avito в браузере программы"
                                    Click="OpenAvito_Click" />
                            <Button x:Name="ImportVisibleReviewsButton"
                                    Content="Повторить импорт отзывов"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Повторить импорт отзывов с открытой страницы Avito"
                                    AutomationProperties.HelpText="Используйте эту кнопку, только если автоматический импорт не начался."
                                    Click="ImportVisibleReviews_Click" />
                            <Button Content="Удалить данные браузера"
                                    AutomationProperties.Name="Выйти из Avito и удалить данные браузера"
                                    AutomationProperties.HelpText="Удаляет cookies, историю и другие данные браузерной сессии МастерFlow."
                                    Click="ClearBrowserData_Click" />
                        </WrapPanel>

                        <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1"
                                Margin="0,0,0,16">
                            <wv2:WebView2 x:Name="AvitoBrowser"
                                         Height="300"
                                         AutomationProperties.Name="Страница Avito для выбора отзывов"
                                         AutomationProperties.HelpText="Обычная страница Avito. Войдите в аккаунт только при необходимости и откройте раздел отзывов." />
                        </Border>

                        <TextBlock x:Name="ReviewImportSummaryText"
                                   Margin="0,0,0,10"
                                   FontWeight="SemiBold"
                                   Text="Отзывы ещё не импортированы."
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="AnalyzeReviewsButton"
                                Content="Проанализировать отзывы"
                                IsEnabled="False"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Проанализировать импортированные отзывы"
                                AutomationProperties.HelpText="Показывает сильные стороны, возможные проблемы и рекомендации. Анализ выполняется на этом компьютере."
                                Click="AnalyzeReviews_Click" />
                        <Label Target="{Binding ElementName=ImportedReviewsList}" Content="Импортированные отзывы" />
                        <ListBox x:Name="ImportedReviewsList"
                                 MinHeight="160"
                                 MaxHeight="280"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Список импортированных отзывов">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AccessibleSummary}"
                                               Margin="4"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <StackPanel x:Name="ReviewAnalysisPanel"
                                    Margin="0,24,0,0"
                                    Visibility="Collapsed">
                            <Separator Margin="0,0,0,20" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Анализ отзывов" />
                            <TextBlock Text="Анализ выполняется на этом компьютере. Отзывы не отправляются в интернет."
                                       Margin="0,0,0,12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ReviewAnalysisSummaryText"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.LiveSetting="Polite" />

                            <Label Target="{Binding ElementName=ReviewStrengthsList}"
                                   Content="Что особенно ценят клиенты"
                                   FontWeight="SemiBold" />
                            <ListBox x:Name="ReviewStrengthsList"
                                     MaxHeight="260"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Сильные стороны по отзывам">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessibleSummary}"
                                                   Margin="4"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock x:Name="NoStrengthsText"
                                       Margin="4,8,0,12"
                                       Text="Повторяющиеся сильные стороны пока не найдены."
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <Label Target="{Binding ElementName=ReviewAttentionList}"
                                   Content="Что требует внимания"
                                   FontWeight="SemiBold" />
                            <ListBox x:Name="ReviewAttentionList"
                                     MaxHeight="220"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Темы, которые требуют внимания">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessibleSummary}"
                                                   Margin="4"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock x:Name="NoAttentionAreasText"
                                       Margin="4,8,0,12"
                                       Text="Повторяющихся проблем в тексте не найдено."
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <Label Target="{Binding ElementName=ReviewRecommendationsList}"
                                   Content="Что можно сделать"
                                   FontWeight="SemiBold" />
                            <ListBox x:Name="ReviewRecommendationsList"
                                     MaxHeight="280"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Рекомендации по отзывам">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessibleSummary}"
                                                   Margin="4"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ConversationsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Анализ переписки" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Вставьте переписку или откройте текстовый файл. Анализ выполняется на этом компьютере. Текст не сохраняется и не отправляется в интернет." />

                        <Border Padding="12"
                                Margin="0,0,0,16"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Text="Перед анализом"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,8"
                                           Text="Удалите лишние имена, телефоны, адреса и медицинские сведения. Используйте переписку только с законным основанием. После анализа нажмите «Очистить переписку»."
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="ConversationConsentCheckBox"
                                          Content="Я проверил текст и согласен обработать его локально"
                                          AutomationProperties.Name="Согласие на локальный анализ переписки"
                                          AutomationProperties.HelpText="Без этой отметки анализ не начнётся." />
                            </StackPanel>
                        </Border>

                        <Label Target="{Binding ElementName=ConversationTextBox}" Content="Текст переписки" />
                        <TextBox x:Name="ConversationTextBox"
                                 MinHeight="220"
                                 MaxHeight="420"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Текст переписки для анализа"
                                 AutomationProperties.HelpText="Для точной проверки начинайте строки словами Клиент, двоеточие, или Мастер, двоеточие." />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Открыть текстовый файл"
                                    AutomationProperties.Name="Открыть текстовый файл с перепиской"
                                    AutomationProperties.HelpText="Поддерживаются файлы TXT размером до двух мегабайт."
                                    Click="OpenConversationTextFile_Click" />
                            <Button Content="Распознать скриншоты"
                                    AutomationProperties.Name="Выбрать скриншоты переписки и распознать текст"
                                    AutomationProperties.HelpText="Поддерживаются до десяти изображений PNG, JPEG, BMP или TIFF. Распознавание выполняется средствами Windows на этом компьютере."
                                    Click="RecognizeConversationScreenshots_Click" />
                            <Button Content="Проанализировать переписку"
                                    AutomationProperties.Name="Проанализировать текст переписки локально"
                                    Click="AnalyzeConversation_Click" />
                            <Button Content="Очистить переписку"
                                    AutomationProperties.Name="Удалить текст переписки из программы"
                                    AutomationProperties.HelpText="Очищает исходный текст и все результаты анализа."
                                    Click="ClearConversation_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="ScreenshotImportStatusText"
                                   Margin="0,0,0,8"
                                   Text="Скриншоты ещё не выбраны."
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite" />

                        <StackPanel x:Name="ConversationAnalysisPanel"
                                    Margin="0,20,0,0"
                                    Visibility="Collapsed">
                            <Separator Margin="0,0,0,20" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Рекомендации" />
                            <TextBlock x:Name="ConversationAnalysisSummaryText"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="ConversationPrivacyText"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <Label Target="{Binding ElementName=CommunicationRecommendationsList}"
                                   Content="Как улучшить ответы клиенту"
                                   FontWeight="SemiBold" />
                            <ListBox x:Name="CommunicationRecommendationsList"
                                     MaxHeight="280"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Рекомендации по общению с клиентом">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessibleSummary}" Margin="4" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Label Target="{Binding ElementName=AdvertisementRecommendationsList}"
                                   Content="Что уточнить в объявлении"
                                   FontWeight="SemiBold" />
                            <ListBox x:Name="AdvertisementRecommendationsList"
                                     MaxHeight="280"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Рекомендации по объявлению">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AccessibleSummary}" Margin="4" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>

                        <Separator Margin="0,28,0,20" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Дополнительный анализ с ИИ" />
                        <TextBlock Margin="0,4,0,12"
                                   Text="Эта функция необязательна. Подготовленный текст будет отправлен в OpenAI. Сначала сохраните свой ключ API в разделе «Настройки»."
                                   TextWrapping="Wrap" />
                        <Button Content="Подготовить текст для ИИ"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Скрыть явные контакты и подготовить текст для ИИ"
                                AutomationProperties.HelpText="Создаёт копию текста и заменяет телефоны, email и ссылки. Исходная переписка не меняется."
                                Click="PrepareConversationForAi_Click" />
                        <TextBlock x:Name="AiPreparationStatusText"
                                   Margin="0,4,0,8"
                                   Text="Текст для ИИ ещё не подготовлен."
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Label Target="{Binding ElementName=AiConversationPreviewTextBox}"
                               Content="Точный текст, который будет отправлен в OpenAI" />
                        <TextBox x:Name="AiConversationPreviewTextBox"
                                 MinHeight="160"
                                 MaxHeight="320"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Текст для отправки в OpenAI"
                                 AutomationProperties.HelpText="Проверьте и удалите имена, адреса, медицинские и другие лишние сведения." />
                        <CheckBox x:Name="AiConversationConsentCheckBox"
                                  Margin="0,0,0,8"
                                  Content="Я проверил текст выше и согласен отправить его в OpenAI"
                                  AutomationProperties.Name="Согласие на отправку подготовленной переписки в OpenAI" />
                        <Button x:Name="AnalyzeConversationWithAiButton"
                                Content="Получить рекомендации ИИ"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Отправить подготовленный текст в OpenAI и получить рекомендации"
                                Click="AnalyzeConversationWithAi_Click" />
                        <Label Target="{Binding ElementName=AiConversationResultTextBox}"
                               Content="Ответ ИИ" />
                        <TextBox x:Name="AiConversationResultTextBox"
                                 MinHeight="180"
                                 MaxHeight="400"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Рекомендации ИИ по переписке"
                                 AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Настройки" />
                        <TextBlock Style="{StaticResource SectionDescription}"
                                   Text="Локальные функции работают без ключа. Ключ OpenAI нужен только для необязательного дополнительного анализа и хранится защищённо для вашей учётной записи Windows." />
                        <TextBlock FontWeight="SemiBold" Text="Модель ИИ: GPT-5.6 Terra" />
                        <TextBlock Margin="0,4,0,16"
                                   Text="Выбрана модель с балансом качества и стоимости. Каждый запрос может расходовать средства вашего аккаунта OpenAI."
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="AiSettingsStatusText"
                                   Margin="0,0,0,12"
                                   Text="Ключ API не сохранён."
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Label Target="{Binding ElementName=OpenAiApiKeyPasswordBox}" Content="Ключ OpenAI API" />
                        <PasswordBox x:Name="OpenAiApiKeyPasswordBox"
                                     MinHeight="40"
                                     Padding="8"
                                     Margin="0,4,0,12"
                                     AutomationProperties.Name="Ключ OpenAI API"
                                     AutomationProperties.HelpText="Вставьте ключ. После сохранения поле очистится, а ключ будет защищён средствами Windows." />
                        <WrapPanel>
                            <Button Content="Сохранить ключ API"
                                    AutomationProperties.Name="Сохранить ключ OpenAI API защищённо"
                                    Click="SaveOpenAiKey_Click" />
                            <Button Content="Удалить ключ API"
                                    AutomationProperties.Name="Удалить сохранённый ключ OpenAI API"
                                    Click="DeleteOpenAiKey_Click" />
                        </WrapPanel>
                        <TextBlock Margin="0,16,0,0"
                                   Text="МастерFlow не показывает сохранённый ключ и не добавляет его в журналы. Удаление ключа отключает только облачный анализ; остальные функции продолжают работать."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
