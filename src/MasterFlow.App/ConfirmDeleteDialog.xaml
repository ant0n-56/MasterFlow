<Window x:Class="MasterFlow.App.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления"
        Width="560"
        SizeToContent="Height"
        MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontSize="16"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        AutomationProperties.Name="Подтверждение удаления клиента">
    <StackPanel Margin="24">
        <TextBlock FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"
                   Text="Удаление клиента" />
        <TextBlock x:Name="ConfirmationMessageText"
                   Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Margin="0,0,0,20"
                   FontWeight="SemiBold"
                   Text="Это действие нельзя отменить."
                   TextWrapping="Wrap" />
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="Отмена"
                    MinHeight="44"
                    Padding="16,8"
                    Margin="0,4,8,4"
                    IsDefault="True"
                    IsCancel="True"
                    AutomationProperties.Name="Отменить удаление клиента" />
            <Button Content="Удалить клиента и записи"
                    MinHeight="44"
                    Padding="16,8"
                    Margin="0,4,0,4"
                    AutomationProperties.Name="Подтвердить удаление клиента и всех его записей"
                    Click="ConfirmDelete_Click" />
        </WrapPanel>
    </StackPanel>
</Window>
